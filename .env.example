# =============================================================================
# Meal Buddy — environment variables
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
#
# NEVER commit real credentials. `.env` is git-ignored. All values below are
# illustrative placeholders — replace them with your real Atlas URI, JWT secret
# and Gemini API key in your local `.env` and in the Render/Vercel dashboards.
#
# Variables are split into two groups:
#   - SERVER-SIDE  → backend (Render). Never expose these to the browser.
#   - BROWSER-SIDE → frontend (Vercel), only variables prefixed VITE_ are
#                    bundled into the client. Never prefix a secret with VITE_.

# ---------------------------------------------------------------------------
# SERVER-SIDE (backend / Render / Express API) — keep out of the frontend
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. The backend persists to the `meal_buddy`
# database (set via MONGODB_DB) so all auth, menu, chat, favorites and food
# profiles are shared across users. When this is empty the backend falls back
# to a local JSON file store (.data/mealbuddy.json) for zero-setup dev.
MONGODB_URI=your_mongodb_atlas_connection_string

# Atlas database name used by the backend.
MONGODB_DB=meal_buddy

# Backend persistence mode:
#   auto (default) = use MongoDB Atlas when MONGODB_URI is set, else JSON store
#   json           = force the local JSON store even if MONGODB_URI is set
DB_BACKEND=auto

# 32+ char secret used to sign JWT access tokens. Generate one with:
#   openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# JWT token lifetime (default 7 days).
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of browser origins allowed to call the API.
# In production, set this to the deployed Vercel frontend URL(s).
CLIENT_ORIGIN=https://your-vercel-app.vercel.app

# Backend port. Render injects PORT automatically; keep 5000 for local dev.
PORT=5000

# ---- AI (server-side) ----
# Gemini provider (default). The API key lives only on the backend.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Vertex AI provider (same AIProvider interface, server-side only).
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=

# ===========================================================================
# BROWSER-SIDE (frontend / Vercel / Vite) — prefix everything with VITE_
# ===========================================================================

# Base URL of the deployed Express backend, e.g. https://mealbuddy-api.onrender.com
# The frontend uses this to reach /api/* (health, auth, menu, chat, favorites,
# food-profile). Leave empty when running fully client-side.
VITE_API_URL=https://mealbuddy-api.onrender.com

# (Optional) Client-side Gemini settings. Only used when the browser calls
# Gemini directly while running without the backend. Prefer GEMINI_API_KEY on
# the backend; NEVER ship a real key in this file.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash