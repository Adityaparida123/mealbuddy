# ---- Server (backend) connection ----
PORT=5000

# ---- Authentication ----
# 32+ char JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- MongoDB Atlas (production) ----
# When set, the API persists to MongoDB Atlas; otherwise it falls back to a
# local JSON store (.data/mealbuddy.json) for zero-setup local dev.
MONGODB_URI=
MONGODB_DB=meal_buddy

# Persistence mode: "auto" (default) = MongoDB when MONGODB_URI is set,
# otherwise local JSON; "json" = force the local JSON store.
DB_BACKEND=auto

# ---- CORS ----
# Comma-separated list of allowed browser origins for the API.
CLIENT_ORIGIN=http://localhost:5173

# ---- AI (server-side only — NEVER expose to the frontend) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional Vertex (same AIProvider interface):
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=