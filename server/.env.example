# ---- Server (backend) port ----
PORT=5000

# ---- Authentication ----
# 32+ char secret used to sign JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# STUDENT default (set automatically); cook accounts created via API with role=COOK

# ---- MongoDB Atlas (production) ----
# When set, the API persists to MongoDB Atlas; otherwise it falls back to a
# local JSON store (zero-setup local dev). Keep this server-side only.
# Create a cluster, then Database Access -> add a user -> Database -> connect
# your app: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=meal_buddy

# ---- Persistence mode ----
# "auto" (default) = use MongoDB Atlas when MONGODB_URI is set, otherwise local JSON.
# "json"          = force the local JSON store even if MONGODB_URI is set.
DB_BACKEND=auto

# ---- AI (server-side only - NEVER put these in the frontend) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional: Vertex AI (works via the same AIProvider interface)
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=

# ---- CORS ----
# Comma-separated list of allowed browser origins for the API.
# In production, point this at the deployed Vercel frontend, e.g.:
CLIENT_ORIGIN=https://your-vercel-app.vercel.app
# For local dev:
# CLIENT_ORIGIN=http://localhost:5173