# Browser-side (Vite) env vars — anything prefixed VITE_ is bundled into the
# client bundle.  NEVER prefix a server secret with VITE_.

# Base URL of the deployed Express backend (Render).
#   VITE_API_URL = https://mealbuddy-32kw.onrender.com
# This is a public URL (NOT a secret) and is consumed by src/services/api.ts.
# It is read at build time by Vite; if the Vercel env var is temporarily missing
# the client falls back to the production Render URL.
VITE_API_URL=https://mealbuddy-32kw.onrender.com
