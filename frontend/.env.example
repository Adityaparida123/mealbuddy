# Browser-side (Vite) env vars — anything prefixed VITE_ is bundled into the
# client bundle. NEVER prefix a server secret with VITE_.

# Base URL of the deployed Express backend (Render).
#   VITE_API_URL = https://mealbuddy-32kw.onrender.com
# Public value (a URL) — it is NOT a secret (see src/services/api.ts).
# The frontend uses it to reach /api/* (health, auth, menu, chat, favorites,
# food-profile). If left empty, src/services/api.ts falls back to the Render URL.
VITE_API_URL=

# (Optional) Client-side Gemini — only used when running WITHOUT the backend.
# Prefer the server-side GEMINI_API_KEY on Render. Never ship a real key here.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash